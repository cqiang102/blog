# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=blog_redis

# 七牛云 Kodo
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_PUBLIC_BUCKET=lacia-public
QINIU_PUBLIC_DOMAIN=https://static.blog.lacia.cn/
QINIU_PRIVATE_BUCKET=lacia-private
QINIU_PRIVATE_DOMAIN=https://file.lacia.cn/
MEDIA_MAX_UPLOAD_SIZE=50MB

# Frontend
FRONTEND_BASE_URL=http://localhost:3000

# OpenAI (聊天模型)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_CHAT_MODEL=deepseek-v4-flash

# Ollama (Embedding 向量化)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_VECTORSTORE_TYPE=none

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT
JWT_SECRET=change-me-to-a-long-random-secret

# Admin Bootstrap
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-local-admin-password
ADMIN_NICKNAME=站长

# MAIL
MAIL_USERNAME=your-qq-email@qq.com
MAIL_PASSWORD=your-smtp-authorization-code
