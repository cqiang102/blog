# ============================
# PostgreSQL (内部服务，不暴露端口)
# ============================
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=your_secure_password_here

# ============================
# Redis
# ============================
REDIS_PASSWORD=your_redis_password_here

# ============================
# MinIO (内部服务，不暴露端口)
# ============================
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=blog-media

# ============================
# OpenAI (聊天模型)
# ============================
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_CHAT_MODEL=deepseek-v4-flash

# ============================
# Ollama (Embedding 向量化)
# Docker 内访问宿主机 Ollama，使用 host.docker.internal
# ============================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ============================
# JWT & 安全
# ============================
JWT_SECRET=your_jwt_secret_at_least_32_chars
REFRESH_COOKIE_SECURE=true

# ============================
# 前端 & CORS
# ============================
FRONTEND_BASE_URL=https://blog.lacia.cn
BLOG_CORS_ALLOWED_ORIGINS=https://blog.lacia.cn

# ============================
# 管理员账号（默认关闭引导；仅首次创建时临时开启）
# ============================
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password
ADMIN_NICKNAME=站长

# ============================
# GitHub OAuth
# 回调地址: https://blog.lacia.cn/login/oauth2/code/github
# ============================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ============================
# SMTP (注册/登录验证码邮件)
# ============================
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-authorization-code

# ============================
# 前端容器端口（仅绑定回环地址，由宿主机 Nginx 对外提供 HTTPS）
# ============================
WEB_PORT=8080
