{$FRONTEND_BASE_URL} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Keep the public upload ceiling slightly above Spring's 50 MB limit.
	request_body {
		max_size 55MB
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:8080 {
			# Stream SSE and other incremental responses without proxy buffering.
			flush_interval -1
		}
	}

	handle /atom.xml {
		rewrite * /api/v1/feed/atom
		reverse_proxy api:8080
	}

	handle {
		root * /srv

		@javascript path_regexp javascript \.js$
		header @javascript Cache-Control "public, max-age=3600, must-revalidate"

		@longLived path_regexp longLived \.(?:wasm|woff2?|ttf|eot|png|jpe?g|gif|ico|svg|webp|css)$
		header @longLived Cache-Control "public, max-age=31536000, immutable"

		@contentAddressedJs path_regexp contentAddressedJs ^/(?:canvaskit|assets)/.*\.js$
		header @contentAddressedJs Cache-Control "public, max-age=31536000, immutable"

		# Apply this last because both files also match the generic JavaScript rule.
		@noCache path /flutter_bootstrap.js /flutter_service_worker.js
		header @noCache Cache-Control "no-cache"

		try_files {path} {path}/ /index.html
		file_server
	}
}
