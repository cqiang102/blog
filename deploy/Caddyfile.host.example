# Merge this site block into the Caddy configuration already running on the
# server. Replace the preview hostname during acceptance, then use the final
# hostname at cutover. The existing static blog can keep its current site block
# until the final reload succeeds.
next.blog.lacia.cn {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Keep the public upload ceiling slightly above Spring's 50 MB limit.
	request_body {
		max_size 55MB
	}

	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:18080 {
			# Stream SSE and other incremental responses without proxy buffering.
			flush_interval -1
		}
	}

	# API-generated signatures use the internal MinIO host. Preserve that Host
	# value while proxying through the loopback-only published port.
	handle_path /minio/* {
		reverse_proxy 127.0.0.1:19000 {
			header_up Host "minio:9000"
		}
	}

	handle {
		# /srv/blog-mimo/current is an atomic symlink to a versioned release.
		root * /srv/blog-mimo/current/web

		@javascript path_regexp javascript \.js$
		header @javascript Cache-Control "public, max-age=3600, must-revalidate"

		@longLived path_regexp longLived \.(?:wasm|woff2?|ttf|eot|png|jpe?g|gif|ico|svg|webp|css)$
		header @longLived Cache-Control "public, max-age=31536000, immutable"

		@contentAddressedJs path_regexp contentAddressedJs ^/(?:canvaskit|assets)/.*\.js$
		header @contentAddressedJs Cache-Control "public, max-age=31536000, immutable"

		# Apply this last because both files also match the generic JavaScript rule.
		@noCache path /flutter_bootstrap.js /flutter_service_worker.js
		header @noCache Cache-Control "no-cache"

		try_files {path} {path}/ /index.html
		file_server
	}
}
